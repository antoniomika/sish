{{template "base" .}}

{{define "title"}}{{.Data.Title}}{{end}}

{{define "meta"}}
{{end}}

{{define "attrs"}}class="container"{{end}}

{{define "body"}}
{{template "nav" .}}

<main>
  <div class="flex flex-col gap-2">
    <div class="hero">
      <div class="box">
        <div class="text-sm mono text-grey mb">sish: ~</div>
        <h1 class="m-0"><span class="text-green">$</span> sish</h1>
        <p class="mono mt">Host public web services on localhost</p>
        <div class="flex items-center gap my mono">
          <a href="/getting-started">[get started]</a>
          <a href="/sitemap">[docs]</a>
        </div>
      </div>
    </div>

    <article class="features">
      <div class="box">
        <h2 class="m-0 text-lg">
          Tunnels to localhost using SSH
        </h2>
        <p class="my">Using SSH tunnels, we can forward requests to your localhost from <a href="/forwarding-types">https, wss, and tcp</a>.</p>
      </div>

      <div class="box">
        <h2 class="m-0 text-lg">
          Self-hosted ngrok alternative
        </h2>
        <p class="my">With docker it is easier than ever to deploy <code>sish</code> to your own VM.</p>
      </div>

      <div class="box">
        <h2 class="m-0 text-lg">
          Fully managed service <a href="https://tuns.sh">tuns.sh</a>
        </h2>
        <p class="my">We also manage an instance of <code>sish</code> so you can start using it immediately.</p>
      </div>
    </article>

    <div>
      <hr />
    </div>

    <article class="group-2 home-features">
      <div class="box hiw">
        <img src="./hiw-sish-public.png" alt="hiw-sish-public" />
      </div>

      <div class="text-center mono my">
        <a href="/how-it-works">[learn more]</a>
      </div>
    </article>
  </div>

  <hr class="my-4" />

  {{template "footer" .}}
</main>
{{end}}
